{
  "name": "@tangow/mobile",
  "version": "2026.11.13",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "expo install --check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/mobile/lib",
    "test:e2e": "maestro test .maestro/smoke.yaml",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production --latest",
    "build:ios:preview": "mkdir -p builds && npx eas-cli@latest build --platform ios --profile preview --local --output builds/tangow-preview.ipa",
    "release:ios": "mkdir -p builds && npx eas-cli@latest build --platform ios --profile production --local --output builds/tangow-production.ipa && npx eas-cli@latest submit --platform ios --profile production --path builds/tangow-production.ipa",
    "generate:share-tokens": "tsx scripts/generate-share-tokens.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.19",
    "@expo/ui": "57.0.26",
    "@tangow/avatars": "workspace:*",
    "@tangow/chat-ui": "workspace:*",
    "@tangow/contracts": "workspace:*",
    "@tangow/core": "workspace:*",
    "@tangow/ui-tokens": "workspace:*",
    "@react-native-vector-icons/ionicons": "13.1.4",
    "@react-native-vector-icons/material-design-icons": "13.1.4",
    "expo": "57.0.34",
    "expo-application": "57.0.3",
    "expo-asset": "57.0.22",
    "expo-audio": "57.0.5",
    "expo-blur": "57.0.3",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.25",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.5",
    "expo-haptics": "57.0.3",
    "expo-image-manipulator": "57.0.23",
    "expo-image-picker": "57.0.22",
    "expo-linking": "57.0.14",
    "expo-localization": "57.0.2",
    "expo-notifications": "57.0.26",
    "expo-router": "57.0.32",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.27",
    "expo-speech-recognition": "57.1.0",
    "expo-splash-screen": "57.0.12",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "expo-updates": "57.0.29",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@react-native/metro-config": "0.86.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  }
}
