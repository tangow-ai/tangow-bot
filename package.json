{
  "name": "tangow",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "tangow": "node scripts/tangow.mjs",
    "test:tangow": "node --test scripts/tangow.test.mjs",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 || exit 0; git config core.hooksPath .githooks",
    "check:staged-size": "node scripts/check-staged-file-size.mjs",
    "test:staged-size": "node --test scripts/check-staged-file-size.test.mjs",
    "dev": "cross-env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 turbo dev --filter=@tangow/api --filter=@tangow/worker --filter=@tangow/web --filter=@tangow/sandbox-supervisor",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @tangow/db generate",
    "db:migrate": "pnpm --filter @tangow/db migrate",
    "sandbox:build": "docker build -t tangow/computer:local infra/sandboxes/computer && docker build -f apps/agent-run-worker/Dockerfile -t tangow/worker:local .",
    "test": "vitest run",
    "test:setup-e2b": "node --test infra/compose/setup-e2b.test.mjs",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:e2e:affected": "tsx packages/testkit/src/cli/e2e-affected.ts",
    "test:e2e:impact-map": "tsx packages/testkit/src/cli/harness.ts --e2e --impact",
    "test:mobile-screenshots": "pnpm --filter @tangow/db generate && tsx packages/testkit/src/cli/mobile-screenshots.ts",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "test:pi": "vitest run packages/testkit/src/model-emulator.test.ts packages/adapters/src/pi-sdk-proof.test.ts packages/adapters/src/pi-sdk-lifecycle.test.ts",
    "bench:worker-plan": "tsx packages/adapters/src/worker-plan-bench.ts",
    "test:worker-live": "tsx packages/testkit/src/cli/worker-live.ts",
    "test:worker-live:bundle": "tsx packages/testkit/src/cli/bundle-worker-live.ts",
    "test:evals": "tsx packages/testkit/src/cli/evals.ts",
    "perf:desktop": "tsx packages/testkit/src/cli/desktop-performance.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts",
    "ship": "bash scripts/ship.sh",
    "ship:test": "bash scripts/ship.test.sh",
    "submit:ios": "pnpm --filter @tangow/mobile submit:ios",
    "build:ios:preview": "pnpm --filter @tangow/mobile build:ios:preview",
    "release:ios": "pnpm --filter @tangow/mobile release:ios",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v",
    "test:model-calibration": "tsx packages/testkit/src/cli/model-calibration.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch",
      "react-native-keyboard-controller@1.21.9": "patches/react-native-keyboard-controller@1.21.9.patch"
    }
  }
}
