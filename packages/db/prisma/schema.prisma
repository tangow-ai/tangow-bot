  sourceMessageId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@map("messaging_outbound")
}

model AgentConnection {
  id             String   @id @default(cuid())
  requesterBotId String
  targetBotId    String
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([requesterBotId, targetBotId])
  @@index([targetBotId, status])
  @@map("agent_connections")
}

model BotSecret {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// The bot whose request saved it, if any. Every bot of the user in the space can use it.
  botId      String?
  bot        Bot?     @relation(fields: [botId], references: [id], onDelete: SetNull)
  name       String
  origin     String
  auth       Json
  ciphertext String
  /// The owner lets every current and future member of the space use it (see bot-secrets.ts).
  sharedWithSpace Boolean @default(false)
  shares     BotSecretShare[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, spaceId, name])
  @@index([botId])
  @@index([spaceId])
  @@map("bot_secrets")
}

/// A person the key's owner shares it with. Leaving the space removes the share.
model BotSecretShare {
  secretId    String
  secret      BotSecret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  spaceId     String
  userId      String
  spaceMember SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@id([secretId, userId])
  @@index([spaceId, userId])
  @@map("bot_secret_shares")
}


model ExternalConversation {
  id                       String            @id @default(cuid())
  provider                 String
  workspaceId              String
  externalKey              String
  conversationId           String
  displayName              String?
  participantNames         String[]          @default([])
  teamChatAmbientEnabled   Boolean?
  teamChatRules            String?
  automatedSenderPolicies  Json              @default("{}")
  spaceId                  String
  space                    Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                    String
  bot                      Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId                   String
  thread                   Thread?
  messages                 ExternalMessage[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([provider, workspaceId, externalKey])
  @@index([spaceId, botId])
  @@map("external_conversations")
}

model ExternalMessage {
  id                     String                @id @default(cuid())
  externalConversationId String
  externalConversation   ExternalConversation  @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)
  providerEventId        String
  kind                   String                @default("direct")
  senderId               String
  senderName             String
  senderIsBot            Boolean               @default(false)
  content                String
  replyThreadId          String?
  batchContext           String?
  engagementReason       String?
  judgedAt               DateTime?
  status                 String                @default("received")
  runId                  String?               @unique
  run                    Run?                  @relation(fields: [runId], references: [id], onDelete: SetNull)
  threadMessageId        String?               @unique
  threadMessage          SessionEntry?         @relation(fields: [threadMessageId], references: [id], onDelete: SetNull)
  attempts               Int                   @default(0)
  nextAttemptAt          DateTime?
  lastError              String?
  providerReplyHandle    String?
  deliveredAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([externalConversationId, providerEventId])
  @@index([status, nextAttemptAt])
  @@map("external_messages")
}

model AgentSecret {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  secretId        String   @unique
  secret          Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([spaceId, name])
  @@index([spaceId, updatedAt])
  @@map("agent_secrets")
}

// Deployment-owned integration credentials; never exposed through read DTOs.
model IntegrationProviderConfig {
  id         String @id
  ciphertext String
  updatedAt  DateTime @updatedAt

  @@map("integration_provider_configs")
}

/// Last complete skill observation from a bot's worker. Files stay on volumes.
model VolumeSkill {
  id          String   @id @default(cuid())
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  source      String
  name        String
  description String
  path        String
  content     String
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([botId, source, name])
  @@map("volume_skills")
}

model RunSnapshot {
  runId String @id
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  sessionId String
  snapshot Json
  receipts Json @default("[]")
  @@map("run_snapshots")
}
