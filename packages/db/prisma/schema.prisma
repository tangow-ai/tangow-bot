  /// deletes it), or when the person removes the preview.
  isLinkPreview    Boolean  @default(false)
  isWidget         Boolean  @default(false)
  previewMessageId String?
  previewMessage   SessionEntry? @relation("LinkPreviewArtifact", fields: [previewMessageId], references: [id], onDelete: SetNull)

