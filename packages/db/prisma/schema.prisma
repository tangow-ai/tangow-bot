  source    String
  createdAt DateTime @default(now())

  @@index([spaceId, createdAt])
  @@index([userId, createdAt])
  @@map("link_preview_reads")
}

/// A link preview read, kept 24 hours per space. `keyHash` is sha256(spaceId + normalized URL):
/// the URL itself is never stored. Failures are kept only when they describe the link.
model LinkPreviewCache {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  keyHash     String
  /// "photo", "page", "refused" or "unreadable". Rows written before ("ok", "failed") are misses.
  status      String
  /// Unused: kept so that an older build rolled back to can still read the table.
  format      String?
  title       String?
  /// Storage key of the WebP bytes in the artifact store; null without an image.
  imageKey    String?
  imageWidth  Int?
  imageHeight Int?
  imageBytes  Int      @default(0)
  /// "contain" when the image is the site's icon (drawn whole); null otherwise.
  imageFit    String?
  /// On a page: whether it declared itself an article; null when read for a mention only.
  article     Boolean?
  /// On a page: the read ended on another site than the link's.
  crossSite   Boolean  @default(false)
  /// Storage key of the 64 px WebP site icon; null without one.
  iconKey     String?
  iconBytes   Int      @default(0)
  /// "server" (read by the server) or "device" (the head was read by the sender's device and the
  /// server fetched the image).
  source      String   @default("server")
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([spaceId, keyHash])
  @@index([spaceId, createdAt])
  @@index([expiresAt])
  @@map("link_preview_cache")
}

model UsageRecord {
  id           String   @id @default(cuid())
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Which bot spent this. Deliberately NOT a relation: a usage row is spend that really
  /// happened, and no lifecycle event on the bot may delete it or blank its attribution.
  /// `Cascade` erased the row; `SetNull` would erase the attribution instead, and because
  /// deleting a bot also deletes its runs, `runId` goes null in the same breath — the row
  /// would keep only space, user, model and token counts.
  ///
  /// So the id outlives the bot and may dangle. Read it with a LEFT JOIN; `BotDeletion.id`
  /// IS the bot id, so a deleted bot's name is still reachable for display.
  botId        String?
  userId       String
  runId        String?
  run          Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  /// The model category that ran a turn (fast, everyday, complex), `fixed` when none picked the
  /// model, `compaction` for history compaction. Null before it was recorded.
  category     String?
  /// One history compaction pass, shared by its summary and fact-extraction calls.
  compactionId String?
  createdAt    DateTime @default(now())

  @@index([spaceId, userId, createdAt])
  @@map("usage_records")
}

